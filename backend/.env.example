# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=relay
DB_PASSWORD=relay_dev_password
DB_DATABASE=relay
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# OpenAI
OPENAI_API_KEY=sk-placeholder-for-dev
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./uploads

# Upload Limits
UPLOAD_MAX_FILE_SIZE=10485760
