# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=relay
DB_PASSWORD=relay_dev_password
DB_DATABASE=relay
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# AI Provider (NVIDIA NIM / OpenAI Compatible)
AI_PROVIDER=nvidia
AI_API_KEY=nvapi-your-key-here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-v4-flash-0731
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./uploads

# Crawl4AI Sidecar
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=relay_crawl_secret
CRAWL4AI_MOCK=false
CRAWL4AI_TIMEOUT_MS=30000

# Upload Limits
UPLOAD_MAX_FILE_SIZE=10485760
